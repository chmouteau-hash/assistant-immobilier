{
  "name": "assistant-immobilier",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:reseau": "next dev -H 0.0.0.0",
    "start:reseau": "next start -H 0.0.0.0",
    "adresse": "node scripts/adresse-reseau.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry --no-version-updates",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "storybook": "10.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
