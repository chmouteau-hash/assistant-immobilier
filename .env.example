# Copier en `.env.local` (ignoré par git). Aucune de ces variables n'est obligatoire en V1 locale.

# Chemin de la base SQLite (défaut : data/dossier.sqlite). `:memory:` pour les tests.
# ASSISTANT_DB_PATH=data/dossier.sqlite

# Dossier des fichiers déposés (défaut : data/fichiers).
# ASSISTANT_FICHIERS_PATH=data/fichiers

# Taille maximale d'un fichier déposé, en octets (défaut : 20 Mo).
# ASSISTANT_FICHIER_MAX_OCTETS=20971520

# Fournisseur IA distant (facultatif). Sans cette clé, seul le fournisseur « règles locales » est
# proposé. Jamais de clé en dur dans le code.
# ANTHROPIC_API_KEY=
# ASSISTANT_IA_MODELE=claude-opus-5-5

# Test depuis un téléphone : noms d'hôte supplémentaires autorisés par le serveur de
# développement (les adresses IPv4 du PC sont détectées automatiquement). Séparés par des virgules.
# ASSISTANT_ORIGINES_DEV=mon-pc.local

# Service d'adresses appelé par « Situer d'après l'adresse » (défaut : Base Adresse Nationale, sur
# la Géoplateforme de l'IGN, sans clé). À ne changer que si le service change d'adresse.
# ASSISTANT_GEOCODAGE_URL=https://data.geopf.fr/geocodage/search
