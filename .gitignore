# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# … sauf le modèle sans secret, qui documente les variables attendues.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Base de données locale (données privées du dossier immobilier) — ne part JAMAIS au dépôt.
/data/*.sqlite
/data/*.sqlite-*

# Fichiers déposés (photos, devis, factures) — données privées, hors dépôt.
/data/fichiers/

# Captures du navigateur de test (Playwright MCP)
/.playwright-mcp/

# Sauvegardes locales (données privées)
/sauvegardes/
/data/avant-restauration-*/
